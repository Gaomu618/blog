---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_AUTHOR } from '../consts';
---

<BaseLayout title="关于" description={`关于 ${SITE_AUTHOR} 的一切`}>
  <section class="container about">
    <h1>关于我</h1>
    <p class="about-intro">
      你好，我是 {SITE_AUTHOR}。一名 Java 的小小学习者，这里记录我学习 Java 的过程、踩过的坑、和一些零散的思考。
    </p>

    <div class="about-section">
      <h2>现在在做的事</h2>
      <ul>
        <li><strong>身份：</strong>Java 学习者</li>
        <li><strong>关注：</strong>Java 基础、Spring、MySQL、设计模式、JVM</li>
        <li><strong>写作：</strong>把学过的知识用自己的话讲一遍</li>
      </ul>
    </div>

    <div class="about-section">
      <h2>技术栈</h2>
      <ul>
        <li><strong>语言：</strong>Java</li>
        <li><strong>框架：</strong>Spring / Spring Boot（学习中）</li>
        <li><strong>数据库：</strong>MySQL</li>
        <li><strong>工具：</strong>IntelliJ IDEA、Maven、Git</li>
        <li><strong>博客：</strong>Astro + Vercel + Markdown</li>
      </ul>
    </div>

    <div class="about-section">
      <h2>联系我</h2>
      <div class="about-social">
        <a href="https://github.com/Gaomu618" rel="noopener">GitHub</a>
        <a href="mailto:2927132157@qq.com">邮箱</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </div>
  </section>
</BaseLayout>
