---
import type { CollectionEntry, MarkdownHeading } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  prevPost?: { id: string; title: string };
  nextPost?: { id: string; title: string };
}

const { post, headings, prevPost, nextPost } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
// 中文短日期:2026-09-05 (en-CA locale 输出 ISO 8601 格式)
const date = new Intl.DateTimeFormat('en-CA').format(pubDate);

// 估算阅读时长（中文按 300 字/分钟，英文按 200 词/分钟）
const body = post.body ?? '';
const wordCount = body.length;
const minutes = Math.max(1, Math.round(wordCount / 400));
---

<BaseLayout title={title} description={description}>
  <div class="layout-with-toc">
    <article class="prose">
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{date}</time>
          <span class="dot">·</span>
          <span>阅读 {minutes} 分钟</span>
          {updatedDate && (
            <>
              <span class="dot">·</span>
              <span>更新于 {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </>
          )}
        </div>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => <a href={`/tags/${tag}/`} class="tag">{tag}</a>)}
          </div>
        )}
      </header>

      <slot />

      <nav class="post-nav">
        {prevPost ? (
          <a href={`/posts/${prevPost.id}/`} class="post-nav-prev">← {prevPost.title}</a>
        ) : <span></span>}
        {nextPost ? (
          <a href={`/posts/${nextPost.id}/`} class="post-nav-next">{nextPost.title} →</a>
        ) : <span></span>}
      </nav>

      <Giscus />
    </article>

    <TOC headings={headings} />
  </div>
</BaseLayout>
